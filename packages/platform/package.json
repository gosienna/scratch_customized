{
  "name": "@scratch-customized/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Custom-mode features for the scratch_customized editor: .sb3 lowering/raising, typed expressions, storage, text mode and version control.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/platform.js",
      "require": "./dist/platform.umd.cjs"
    }
  },
  "main": "dist/platform.umd.cjs",
  "module": "dist/platform.js",
  "files": [
    "LICENSE",
    "TRADEMARK",
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build",
    "clean": "rimraf dist",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "test": "npm run lint && vitest run",
    "test:unit": "vitest run",
    "watch": "vite build --watch"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.90",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.9.10",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "unplugin-dts": "1.1.2",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@isomorphic-git/lightning-fs": "4.10.5",
    "diff": "9.0.0",
    "idb": "8.0.4",
    "isomorphic-git": "1.44.19",
    "jszip": "3.10.2"
  }
}
